# Fallback includes for editors when compile_commands.json is missing or not
# picked up. CMake still supplies the authoritative flags via the build tree.
CompileFlags:
  Add:
    - -std=c++17
    - -I/opt/homebrew/opt/libpqxx/include
    - -I/opt/homebrew/opt/libpq/include
    - -I/usr/local/opt/libpqxx/include
    - -I/usr/local/opt/libpq/include
  CompilationDatabase: build-verify
